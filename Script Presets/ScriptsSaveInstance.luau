-- CompleteSaveInstance / ScriptsSaveInstance
-- Authorized script-focused export with per-job decompilation and bytecode timeouts.
-- Status: runtime-unverified. Generated by scripts/generate_presets.py; edit presets.json.
-- License: AGPL-3.0. See LICENSE and NOTICE.md for upstream attribution.

-- Relative to the runtime's file workspace, not the Git checkout on your PC.
local CORE_PATH = "CompleteSaveInstance/saveinstance.luau"
local CORE_URL = "https://raw.githubusercontent.com/g0shtj0sh/CompleteSaveInstance/v0.2.0/saveinstance.luau"
local PRESET_ID = "ScriptsSaveInstance"
local options = {
	mode = "scripts",
	Binary = true,
	CompressionMode = "lz4",
	Decompile = true,
	DecompileTimeout = 10,
	SaveBytecode = true,
	BytecodeTimeout = 3,
	IgnorePropertiesOfNotScriptsOnScriptsMode = true,
	NilInstances = false,
	IgnoreSpecialProperties = true,
	IgnoreDefaultPlayerScripts = true,
	AlternativeWritefile = false,
	SafeMode = false,
	KillAllScripts = false,
	BoostFPS = false,
	ShutdownWhenDone = false,
	ShowStatus = true,
	__DEBUG_MODE = true,
}

local prefix = "[CSI / " .. PRESET_ID .. "] "
local function fail(message)
	error(prefix .. message, 0)
end

if type(readfile) ~= "function" or type(writefile) ~= "function" or type(loadstring) ~= "function" then
	fail("This preset requires readfile, writefile, and loadstring. Use a compatible local runtime.")
end

-- Unique names help avoid confusing an old file with this run's output.
local runId = tostring(game.PlaceId) .. "_" .. tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
options.FilePath = PRESET_ID .. "_" .. runId .. ".rbxl"
local probePath = "CSI_WriteProbe_" .. runId .. ".txt"
local marker = "CompleteSaveInstance write probe " .. runId
local probeOk, probeError = pcall(function()
	writefile(probePath, marker)
	if readfile(probePath) ~= marker then
		error("Write/read probe content did not match", 0)
	end
end)
if type(delfile) == "function" then
	pcall(delfile, probePath)
end
if not probeOk then
	fail("Basic file probe failed: " .. tostring(probeError))
end

print(prefix .. "Write/read probe passed. Output: " .. options.FilePath)
print(prefix .. "Runtime status: runtime-unverified. Per-job timeouts do not bound the total export duration.")
local started = os.clock()
local ok, result = xpcall(function()
	local localOk, localSource = pcall(readfile, CORE_PATH)
	local source
	if localOk and type(localSource) == "string" and #localSource > 0 then
		print(prefix .. "Loading local core: " .. CORE_PATH)
		source = localSource
	else
		print(prefix .. "Loading pinned core: " .. CORE_URL)
		source = game:HttpGet(CORE_URL, true)
	end
	local chunk, compileError = loadstring(source, "CompleteSaveInstance")
	if not chunk then
		error("Core compilation failed: " .. tostring(compileError), 0)
	end
	local completeSaveInstance = chunk()
	if type(completeSaveInstance) ~= "function" then
		error("Core did not return an export function", 0)
	end
	completeSaveInstance(options)
end, function(message)
	if debug and type(debug.traceback) == "function" then
		return debug.traceback(tostring(message), 2)
	end
	return tostring(message)
end)
if not ok then
	fail("Export failed. Check CORE_PATH and console details: " .. tostring(result))
end

print(prefix .. string.format("Export function returned after %.2fs; file validity is unverified.", os.clock() - started))
if type(isfile) == "function" then
	local checked, exists = pcall(isfile, options.FilePath)
	if checked and exists then
		print(prefix .. "Output exists: " .. options.FilePath .. ". Open and inspect it in Roblox Studio.")
	elseif checked then
		warn(prefix .. "Output not found: " .. options.FilePath .. ". Do not treat this run as a successful backup.")
	else
		warn(prefix .. "Output existence check failed: " .. tostring(exists))
	end
else
	warn(prefix .. "isfile is unavailable; output existence remains unverified.")
end
